# Project URL only (Dashboard → Project Settings → API). No /rest/v1 suffix.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your_publishable_key

# EAS production builds do not use this file — set the same EXPO_PUBLIC_* vars in
# Expo dashboard → Project → Environment variables (production), or the app crashes on launch.
#
# GitHub Pages web deploys (Actions → Secrets / Variables) need the same EXPO_PUBLIC_* values:
#   Secrets: EXPO_PUBLIC_SUPABASE_URL, EXPO_PUBLIC_SUPABASE_KEY, EXPO_PUBLIC_ADMIN_EMAILS (optional)
#   Variables: EXPO_PUBLIC_LEGAL_BASE_URL, EXPO_PUBLIC_SUPPORT_EMAIL
# Never put Edge Function secrets (OPENROUTER_*, OPEN_ROUTER_*, YouTube, ScrapeCreators, Apple revoke) in the web job.

# Supabase Dashboard → Authentication → URL Configuration:
# Site URL (mobile primary): pinch://
# Redirect URLs (add every line):
#   pinch://reset-password
#   pinch://auth-callback
#   pinch://**
#   https://pinch-app.io
#   https://pinch-app.io/auth-callback
#   https://pinch-app.io/reset-password
#   https://pinch-app.io/welcome
# Dev (Expo Go): exp://127.0.0.1:8081/--/**
# Dev (web): http://localhost:8081/**
# Do NOT leave Site URL as http://localhost:3000 — reset emails will open localhost.

# Comma-separated emails that can open Settings → Admin usage tracker
# (also set profiles.is_admin = true for those users after migration 0009)
EXPO_PUBLIC_ADMIN_EMAILS=you@example.com

# Public site. Legal HTML lives alongside the web app (privacy.html, terms.html).
# No trailing slash.
EXPO_PUBLIC_LEGAL_BASE_URL=https://pinch-app.io
EXPO_PUBLIC_SUPPORT_EMAIL=you@example.com

# RevenueCat recipe-credit purchases. Keep disabled until all products and the
# authenticated webhook are configured and sandbox-tested.
EXPO_PUBLIC_CREDIT_PURCHASES_ENABLED=false
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_public_sdk_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_public_sdk_key
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=rcb_your_public_web_key
# Identified RevenueCat Web Purchase Links, one per consumable pack.
EXPO_PUBLIC_REVENUECAT_WEB_10_URL=https://pay.rev.cat/your-10-credit-link
EXPO_PUBLIC_REVENUECAT_WEB_30_URL=https://pay.rev.cat/your-30-credit-link
EXPO_PUBLIC_REVENUECAT_WEB_100_URL=https://pay.rev.cat/your-100-credit-link

# Optional — used by docs / future Universal Links. The app reads store links
# from src/lib/appStore.ts, and share pages from legal/share.html and the worker.
# EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/us/app/pinch-recipe-library/id6796310453
# EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.pinch.myapp

# Server-side only — set these in Supabase Edge Function secrets, not in the Expo app
# CREDIT_PURCHASES_ENABLED=false
# REVENUECAT_WEBHOOK_AUTH="Bearer generate-a-long-random-secret"
# OpenRouter: every model call (text, vision, video, Jev). Accepts OPEN_ROUTER_API_KEY as an alias.
# OPENROUTER_API_KEY=sk-or-v1-your_key
# Per-task overrides (ADR 015). Defaults: TASK_MODELS in supabase/functions/_shared/llmClient.ts.
# OPENROUTER_MODEL_<KIND>=vendor/model      OPENROUTER_FALLBACKS_<KIND>=a,b|none      OPENROUTER_REASONING_<KIND>=none|low|medium
# Extract gate and remix relatedness (TypeSafe Jev, same key). Defaults to typesafe/jev-1.13.
# JEV_MODEL=typesafe/jev-1.13
# For Sign in with Apple token revoke on account deletion (optional until iOS ship):
# APPLE_CLIENT_ID=com.pinch.myapp
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_KEY_ID=XXXXXXXXXX
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
