# Copy to web/.env.local for `npm run dev`. Same values as the mobile app's EXPO_PUBLIC_SUPABASE_* in ../.env.
# Production is the only Supabase project, so local dev signs in to real accounts. For a throwaway setup, start
# local Supabase (`npx supabase start` at the repo root) and use its API URL and anon key instead.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your_publishable_key
NEXT_PUBLIC_CREDIT_PURCHASES_ENABLED=false
