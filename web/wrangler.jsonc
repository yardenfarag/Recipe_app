// The new web app (ADR 027). Built by `opennextjs-cloudflare build`, deployed by .github/workflows/deploy-web-app.yml.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinch-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pinch-web"
    }
  ],
  // Cloudflare's browser, for the PDF cookbook (app/api/cookbook/pdf, ADR 028). Local `wrangler dev` runs a local Chrome.
  "browser": { "binding": "BROWSER" },
  // Five cookbooks a minute per account: each keeps a browser busy, and browser time is billed past 10 hours a month.
  "ratelimits": [{ "name": "COOKBOOK_PDF_LIMITER", "namespace_id": "1042", "simple": { "limit": 5, "period": 60 } }],
  "workers_dev": false,
  // While we build. After the switch (PIN-147) this becomes the zone routes
  // pinch-app.io/app and pinch-app.io/app/* (never /app*, which also matches /apple-app-site-association).
  "routes": [{ "pattern": "next.pinch-app.io", "custom_domain": true }]
}
