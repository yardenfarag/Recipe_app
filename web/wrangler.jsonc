// The new web app (ADR 027). Built by `opennextjs-cloudflare build`, deployed by .github/workflows/deploy-web-app.yml.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinch-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pinch-web"
    }
  ],
  // Cloudflare's browser, for the PDF cookbook (app/api/cookbook/pdf, ADR 028). Local `wrangler dev` runs a local Chrome.
  "browser": { "binding": "BROWSER" },
  // Five cookbooks a minute per account: each keeps a browser busy, and browser time is billed past 10 hours a month.
  "ratelimits": [{ "name": "COOKBOOK_PDF_LIMITER", "namespace_id": "1042", "simple": { "limit": 5, "period": 60 } }],
  "workers_dev": false,
  // A preview link per PR on workers.dev (.github/workflows/web-preview.yml). It runs that PR's code
  // against the same production bindings. The app itself stays off workers.dev (workers_dev above).
  "preview_urls": true,
  // pinch-app.io/app is this app since the switch (PIN-147). Everything else on pinch-app.io stays with GitHub Pages
  // and the share Worker (ADR 027). Exactly these two patterns: /app* would also catch /apple-app-site-association,
  // which the share Worker serves for universal links. To switch back to the Expo web app, see docs/WEB-APP-SWITCH.md.
  // next.pinch-app.io stays as a second address of the same app until the Expo web app is removed (PIN-148).
  "routes": [
    { "pattern": "pinch-app.io/app", "zone_name": "pinch-app.io" },
    { "pattern": "pinch-app.io/app/*", "zone_name": "pinch-app.io" },
    { "pattern": "next.pinch-app.io", "custom_domain": true }
  ]
}
