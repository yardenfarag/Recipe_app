{
  "expo": {
    "name": "Pinch",
    "slug": "pinch",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pinch",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "translucent": true
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.pinch.myapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pinch.myapp",
      "backgroundColor": "#F4F1F8",
      "permissions": [
        "com.android.vending.BILLING"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F4F1F8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "lang": "en",
      "name": "Pinch — Save TikTok, Instagram, and YouTube recipes",
      "shortName": "Pinch",
      "description": "Pinch turns a TikTok, Instagram, or YouTube cooking video into ingredients, steps, and a shopping list."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pinch uses your photos to Snap recipes and match what’s in your fridge.",
          "cameraPermission": "Pinch uses your camera to Snap recipes and match what’s in your fridge."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "useLegacyPackaging": false,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keepattributes SourceFile,LineNumberTable\n-keepattributes *Annotation*\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "yardenfa",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "58f56906-4b2d-49ca-9e87-a706b5d7cf1f"
      },
      "legalBaseUrl": "https://pinch-app.io",
      "supportEmail": "yarden.farag@gmail.com"
    }
  }
}
